# Oturum çerezini imzalayan anahtar. En az 32 karakter olmalı.
# Üretimde mutlaka değiştirin: openssl rand -base64 48
SESSION_SECRET="buraya-en-az-32-karakterlik-rastgele-bir-deger-yazin"

# Seed betiğinin oluşturacağı admin şifresi.
SEED_ADMIN_PASSWORD="Admin1234!"
